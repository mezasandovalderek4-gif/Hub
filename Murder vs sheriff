local function toggle(title, desc, default, cb)
    local f = row(title, desc, 52)
    local state = default or false
    local track_ = new("Frame", {
        Size = UDim2.fromOffset(38, 20), Position = UDim2.new(1, -48, 0.5, -10),
        BackgroundColor3 = Color3.fromRGB(58, 58, 68), BorderSizePixel = 0,
    }, f)
    corner(track_, 10)
    local knob = new("Frame", { Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(2, 2), BackgroundColor3 = Color3.fromRGB(230, 230, 235), BorderSizePixel = 0 }, track_)
    corner(knob, 8)

    local function apply(v)
        state = v
        game:GetService("TweenService"):Create(track_, TweenInfo.new(0.15), { BackgroundColor3 = v and ACCENT or Color3.fromRGB(58, 58, 68) }):Play()
        game:GetService("TweenService"):Create(knob, TweenInfo.new(0.15), { Position = v and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2) }):Play()
        if cb then pcall(cb, v) end
    end

    local hit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "" }, f)
    hit.MouseButton1Click:Connect(function() apply(not state) end)
    apply(state)
    return apply
end

local function slider(title, desc, min, max, default, cb)
    local f = new("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = CARD, BorderSizePixel = 0 }, scroll)
    corner(f, 8); stroke(f)
    new("TextLabel", {
        Size = UDim2.new(1, -50, 0, 18), Position = UDim2.fromOffset(10, 7), BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = TXT, TextXAlignment = Enum.TextXAlignment.Left, Text = title,
    }, f)
    local val = new("TextLabel", {
        Size = UDim2.fromOffset(38, 18), Position = UDim2.new(1, -48, 0, 7), BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = ACCENT, TextXAlignment = Enum.TextXAlignment.Right, Text = tostring(default),
    }, f)
    new("TextLabel", {
        Size = UDim2.new(1, -20, 0, 12), Position = UDim2.fromOffset(10, 24), BackgroundTransparency = 1,
        Font = Enum.Font.Gotham, TextSize = 9, TextColor3 = SUB, TextXAlignment = Enum.TextXAlignment.Left,
        Text = desc or "", TextTruncate = Enum.TextTruncate.AtEnd,
    }, f)

    local bar = new("Frame", { Size = UDim2.new(1, -20, 0, 4), Position = UDim2.new(0, 10, 1, -12), BackgroundColor3 = Color3.fromRGB(58, 58, 68), BorderSizePixel = 0 }, f)
    corner(bar, 2)
    local fill = new("Frame", { Size = UDim2.new((default - min) / (max - min), 0, 1, 0), BackgroundColor3 = ACCENT, BorderSizePixel = 0 }, bar)
    corner(fill, 2)
    local dot = new("Frame", { Size = UDim2.fromOffset(10, 10), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = Color3.fromRGB(240, 240, 245), BorderSizePixel = 0 }, fill)
    corner(dot, 5)

    local value = default
    local dragging_ = false
    local function setFromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel + 0.5)
        val.Text = tostring(value)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        if cb then pcall(cb, value) end
    end

    local hit = new("TextButton", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 1, -22), BackgroundTransparency = 1, Text = "" }, f)
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging_ = true; setFromX(i.Position.X)
        end
    end)
    track(UIS.InputChanged:Connect(function(i)
        if dragging_ and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setFromX(i.Position.X)
        end
    end))
    track(UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging_ = false end
    end))
    return function(v) value = v; val.Text = tostring(v); fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0) end
end

