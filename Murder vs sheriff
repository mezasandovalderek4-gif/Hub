--  REMOTES / ROLES
-- ============================================================
local remotes = RS:FindFirstChild("Remotes") or RS
local function findRemote(n)
    for _, o in ipairs(remotes:GetDescendants()) do
        if o:IsA("RemoteEvent") and o.Name:lower() == n:lower() then return o end
    end
    return nil
end
local ShootGun   = findRemote("ShootGun")
local ThrowKnife = findRemote("ThrowKnife")
local HitPlayer  = findRemote("HitPlayer") or findRemote("Hit")

local function getRole(plr)
    local packs = { plr.Character, plr:FindFirstChild("Backpack") }
    for _, c in ipairs(packs) do
        if c then
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") then
                    local n = t.Name:lower()
                    if n:find("knife") then return "Murderer", RED end
                    if n:find("gun") then return "Sheriff", BLUE end
                end
            end
        end
    end
    return "Innocent", GREEN
end

local function alive(plr)
    local c = plr.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    return c and h and h.Health > 0
end

local function nearest(skipMurdererOnly)
    local best, dist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) then
            local ok = true
            if skipMurdererOnly then
                local r = getRole(p)
                ok = (r == "Murderer")
            end
            if ok then
                local d = (p.Character.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                if d < dist then best, dist = p, d end
            end
        end
    end
    return best, dist
end

-- ============================================================
--  ESP
-- ============================================================
local cfg = { esp = false, espMurderer = true, espSheriff = true, espInnocent = false, espCoin = false, espDist = 250 }
local espData = {}

local function clearESP()
    for plr, d in pairs(espData) do
        if d.hl then d.hl:Destroy() end
        if d.bg then d.bg:Destroy() end
        espData[plr] = nil
    end
end

local function buildESP(plr)
    local char = plr.Character
    local head = char and char:FindFirstChild("Head")
    if not head then return end

    local role, color = getRole(plr)
    local hl = new("Highlight", {
        Adornee = char, FillColor = color, FillTransparency = 0.72,
        OutlineColor = color, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    }, char)

    local bg = new("BillboardGui", {
        Size = UDim2.fromOffset(180, 34), StudsOffset = Vector3.new(0, 2.6, 0), AlwaysOnTop = true, MaxDistance = cfg.espDist,
    }, head)
    local lbl = new("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        TextSize = 11, TextColor3 = color, TextStrokeTransparency = 0.4, Text = "",
    }, bg)

    espData[plr] = { hl = hl, bg = bg, lbl = lbl }
end

track(RunService.Heartbeat:Connect(function()
    if not cfg.esp then
        if next(espData) then clearESP() end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local d = espData[plr]
        local char = plr.Character
        if not char or not char:FindFirstChild("Head") then
            if d then d.hl:Destroy(); d.bg:Destroy(); espData[plr] = nil end
            continue
        end
        if not d then buildESP(plr); d = espData[plr] end
        if d then
            local role, color = getRole(plr)
            local visible = (role == "Murderer" and cfg.espMurderer)
                or (role == "Sheriff" and cfg.espSheriff)
                or (role == "Innocent" and cfg.espInnocent)
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local dist = hrp and math.floor((hrp.Position - workspace.CurrentCamera.CFrame.Position).Magnitude) or 0
            d.hl.Enabled = visible
            d.bg.Enabled = visible
            d.hl.FillColor = color; d.hl.OutlineColor = color
            d.lbl.TextColor3 = color
            d.lbl.Text = string.format("%s | %d m", role, dist)
            d.bg.MaxDistance = cfg.espDist
            if d.hl.Adornee ~= char then d.hl.Adornee = char end
            if d.bg.Parent ~= char:FindFirstChild("Head") and char:FindFirstChild("Head") then
                d.bg.Parent = char:FindFirstChild("Head")
            end
        end
    end
end))

